{
  "model_parameters": {
    "summarization_model": "google/flan-t5-large",
    "retrieval_model": "sentence-transformers/all-MiniLM-L6-v2",
    "re_ranker_model": "cross-encoder/ms-marco-MiniLM-L-6-v2"
  },
  "generation_hyperparameters": {
    "repetition_penalty": 2.0,
    "no_repeat_ngram_size": 3,
    "cross_encoder_confidence_threshold": 0.5
  },
  "text_processing": {
    "sliding_window_chunk_size": 150,
    "sliding_window_overlap": 30
  }
}